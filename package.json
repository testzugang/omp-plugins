{
  "name": "@testzugang/omp-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo workspace for selected OMP plugins.",
  "keywords": [
    "omp-plugin",
    "omp",
    "skills",
    "extensions"
  ],
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "omp": {
    "extensions": [
      "./extensions/session-branding",
      "./packages/omp-pr-findings/extensions",
      "./packages/omp-handoff-session/extensions/handoff-session"
    ]
  },
  "scripts": {
    "validate": "node scripts/validate-package.mjs",
    "validate:skills": "node scripts/validate-package.mjs --skills-only",
    "test": "vitest run",
    "test:skills": "vitest run tests/skills",
    "format": "prettier '**/*.{ts,js,cjs,md,json,yml,yaml}' --write",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@oh-my-pi/pi-ai": "^17.0.9",
    "@oh-my-pi/pi-coding-agent": "^17.0.9",
    "@oh-my-pi/pi-tui": "^17.0.9",
    "prettier": "^3.5.3",
    "vitest": "^4.1.8"
  }
}
